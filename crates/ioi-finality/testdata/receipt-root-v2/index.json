{
  "algorithm": "ioi.receipt-merkle-rfc9162-jcs-sha256.v1",
  "definitions": {
    "base64": "producers emit standard padded Base64 (RFC 4648 section 4); verifiers accept standard or URL-safe (one alphabet per string, padding optional), as DSSE v1.0.2 requires; D(E) is over the carried strings, so a re-encoded envelope has a different D(E) (Q7 as amended 2026-10-12)",
    "envelope_digest": "D(E) = \"sha256:\" + hex(SHA-256(JCS(E'))), E' = {payloadType, payload, signatures[{keyid (iff present), sig}] in carried order}; unknown members excluded",
    "leaf_input": "d(i) = ASCII \"IOI-RECEIPT-MERKLE-LEAF-V1\" || 0x00 || JCS({\"envelope_digest\": D(E_i), \"sequence\": s_i})",
    "receipt_root": "\"sha256:\" + lowercase hex of the 32-byte MTH; receipts ascending and contiguous over receipt_range; an empty range is refused",
    "tree": "RFC 9162 section 2.1.1 MTH: leaf SHA-256(0x00 || d), node SHA-256(0x01 || left || right), k = the largest power of two < n, no odd-node duplication"
  },
  "generator": "gen_receipt_root_v2.py",
