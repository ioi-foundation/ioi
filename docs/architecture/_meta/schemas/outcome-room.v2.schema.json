{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ioi/applications/ioi-ai/outcome-room/v2",
  "title": "OutcomeRoom",
  "x-ioi-schema-version": "ioi.applications.ioi-ai.outcome-room.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_room_id",
    "system_id",
    "genesis_ref",
    "package_id",
    "manifest_ref",
    "constitution_ref",
    "active_profile_refs",
    "autonomous_system_state_ref",
    "owner_or_sponsor_ref",
    "objective_ref",
    "objective",
    "constraint_refs",
    "acceptance_criteria_refs",
    "stop_policy_ref",
    "room_mode",
    "visibility_policy_ref",
    "participation_policy_ref",
    "privacy_policy_ref",
    "contribution_policy_ref",
    "cooperation_surplus_policy_ref",
    "collaboration_terms_refs",
    "discovery_and_external_admission_policy_refs",
    "artifact_license_rights_retention_and_export_policy_refs",
    "coordination_topology",
    "coordination_policy_ref",
    "host_domain_ref",
    "ordering_and_merge_policy_ref",
    "conflict_and_failover_policy_ref",
    "multi_party_collaboration_ref",
    "ontology_profile_refs",
    "scorecard_and_guardrail_refs",
    "verifier_path_refs",
    "resource_and_budget_refs",
    "settlement_policy_ref",
    "participant_lease_refs",
    "member_goal_run_refs",
    "participation_request_refs",
    "resource_offer_refs",
    "capability_offer_refs",
    "frontier_item_refs",
    "attempt_refs",
    "finding_refs",
    "verifier_challenge_refs",
    "discussion_projection_refs",
    "admission_and_replay_refs",
    "contribution_refs",
    "participant_state_bundle_refs",
    "latest_sequence",
    "latest_transition_commitment_ref",
    "room_state_root",
    "room_receipt_root",
    "status"
  ],
  "$defs": {
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9+._-]*://[^\\s]{1,500}$" },
    "refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "nullableRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "properties": {
    "schema_version": { "const": "ioi.applications.ioi-ai.outcome-room.v2" },
    "outcome_room_id": { "type": "string", "pattern": "^outcome-room://[^\\s]{1,500}$" },
    "system_id": { "type": "string", "pattern": "^system://[^\\s]{1,500}$" },
    "genesis_ref": { "anyOf": [{ "type": "string", "pattern": "^genesis://[^\\s]{1,500}$" }, { "type": "null" }] },
    "package_id": { "type": "string", "pattern": "^package://[^\\s]{1,500}$" },
    "manifest_ref": { "type": "string", "pattern": "^package://[^\\s?#\\\\]{1,160}/release/[^\\s?#\\\\]{1,160}$" },
    "constitution_ref": { "type": "string", "pattern": "^constitution://[^\\s]{1,500}$" },
    "active_profile_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_profile_ref",
        "ordering_admission_finality_profile_ref",
        "oracle_evidence_profile_refs",
        "lifecycle_continuity_profile_ref",
        "network_enrollment_ref"
      ],
      "properties": {
        "deployment_profile_ref": { "type": "string", "pattern": "^deployment-profile://[^\\s]{1,500}$" },
        "ordering_admission_finality_profile_ref": { "type": "string", "pattern": "^ordering-profile://[^\\s]{1,500}$" },
        "oracle_evidence_profile_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^oracle-evidence-profile://[^\\s]{1,500}$" } },
        "lifecycle_continuity_profile_ref": { "type": "string", "pattern": "^lifecycle-profile://[^\\s]{1,500}$" },
        "network_enrollment_ref": { "anyOf": [{ "type": "string", "pattern": "^network-enrollment://[^\\s]{1,500}$" }, { "type": "null" }] }
      }
    },
    "autonomous_system_state_ref": { "type": "string", "pattern": "^agentgres://[^\\s]{1,500}$" },
    "owner_or_sponsor_ref": { "type": "string", "pattern": "^(?:system|user|org|project|domain|service)://[^\\s]{1,500}$" },
    "objective_ref": { "type": "string", "pattern": "^(?:goal|task|service)://[^\\s]{1,500}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "constraint_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:constraint|policy|budget)://[^\\s]{1,500}$" } },
    "acceptance_criteria_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:rubric|gate|policy)://[^\\s]{1,500}$" } },
    "stop_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "room_mode": { "enum": ["private_goal", "permissioned_team", "cross_org", "open_challenge"] },
    "visibility_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "participation_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "privacy_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "contribution_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "cooperation_surplus_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "collaboration_terms_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^terms://[^\\s]{1,500}$" } },
    "discovery_and_external_admission_policy_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:policy|room-discovery|aiip)://[^\\s]{1,500}$" } },
    "artifact_license_rights_retention_and_export_policy_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:policy|license)://[^\\s]{1,500}$" } },
    "coordination_topology": { "enum": ["hosted_admission", "federated_admission"] },
    "coordination_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "host_domain_ref": { "anyOf": [{ "type": "string", "pattern": "^(?:system|domain)://[^\\s]{1,500}$" }, { "type": "null" }] },
    "ordering_and_merge_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "conflict_and_failover_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
    "multi_party_collaboration_ref": { "anyOf": [{ "type": "string", "pattern": "^collaboration://[^\\s]{1,500}$" }, { "type": "null" }] },
    "ontology_profile_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:ontology|semantic-profile|ontology-mapping)://[^\\s]{1,500}$" } },
    "scorecard_and_guardrail_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:benchmark|rubric|gate|policy)://[^\\s]{1,500}$" } },
    "verifier_path_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^verifier-path://[^\\s]{1,500}$" } },
    "resource_and_budget_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:resource-pool|budget|goal-budget|order)://[^\\s]{1,500}$" } },
    "settlement_policy_ref": { "anyOf": [{ "type": "string", "pattern": "^policy://[^\\s]{1,500}$" }, { "type": "null" }] },
    "participant_lease_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^participant-lease://[^\\s]{1,500}$" } },
    "member_goal_run_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^goal://[^\\s]{1,500}$" } },
    "participation_request_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^participation-request://[^\\s]{1,500}$" } },
    "resource_offer_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^resource-offer://[^\\s]{1,500}$" } },
    "capability_offer_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^capability-offer://[^\\s]{1,500}$" } },
    "frontier_item_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^frontier://[^\\s]{1,500}$" } },
    "attempt_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^attempt://[^\\s]{1,500}$" } },
    "finding_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^finding://[^\\s]{1,500}$" } },
    "verifier_challenge_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^verifier-challenge://[^\\s]{1,500}$" } },
    "discussion_projection_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:projection|message)://[^\\s]{1,500}$" } },
    "admission_and_replay_refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:receipt|replay|agentgres)://[^\\s]{1,500}$" } },
    "contribution_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:contribution|receipt)://[^\\s]{1,500}$" } },
    "participant_state_bundle_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^participant-state://[^\\s]{1,500}$" } },
    "latest_sequence": { "type": "integer", "minimum": 0, "maximum": 127 },
    "latest_transition_commitment_ref": { "type": "string", "pattern": "^commitment://[^\\s]{1,500}$" },
    "room_state_root": { "$ref": "#/$defs/hash" },
    "room_receipt_root": { "$ref": "#/$defs/hash" },
    "status": { "enum": ["proposed", "open", "active", "paused", "blocked", "verifying", "accepted", "disputed", "settled", "closed", "revoked", "archived"] }
  }
}
