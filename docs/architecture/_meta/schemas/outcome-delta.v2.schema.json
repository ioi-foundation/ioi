{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://ioi/foundations/outcome-delta/v2",
  "title": "OutcomeDelta",
  "x-ioi-schema-version": "ioi.foundations.outcome-delta.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome_delta_id", "work_subject_ref", "outcome_room_ref", "room_admission", "proposed_by_ref", "target_ref", "delta_kind", "payload_ref", "precondition_and_invariant_refs", "expected_effect_ref", "verifier_and_acceptance_refs", "information_flow_label_refs", "status"],
  "$defs": {
    "ref": { "type": "string", "pattern": "^[a-z][a-z0-9+._-]*://[^\\s]{1,500}$" },
    "refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "nullableRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "roomAdmission": {
      "type": "object",
      "required": ["schema_version", "room_system_id", "outcome_room_ref", "proposed_or_issued_by_ref", "expected_room_revision", "expected_predecessor_commitment_ref", "payload_root", "admission_policy_ref", "admission_decision_ref", "admission_receipt_ref", "admitted_sequence", "resulting_room_revision", "resulting_transition_commitment_ref", "resulting_room_state_root", "resulting_receipt_root", "created_at", "updated_at", "admission_status"],
      "properties": {
        "schema_version": { "const": "ioi.foundations.room-admitted-object-base.v2" },
        "room_system_id": { "type": "string", "pattern": "^system://[^\\s]{1,500}$" },
        "outcome_room_ref": { "type": "string", "pattern": "^outcome-room://[^\\s]{1,500}$" },
        "proposed_or_issued_by_ref": { "type": "string", "pattern": "^(?:participant-lease|system)://[^\\s]{1,500}$" },
        "expected_room_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expected_predecessor_commitment_ref": { "type": "string", "pattern": "^commitment://[^\\s]{1,500}$" },
        "payload_root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "admission_policy_ref": { "type": "string", "pattern": "^policy://[^\\s]{1,500}$" },
        "admission_decision_ref": { "anyOf": [{ "type": "string", "pattern": "^decision://[^\\s]{1,500}$" }, { "type": "null" }] },
        "admission_receipt_ref": { "anyOf": [{ "type": "string", "pattern": "^receipt://[^\\s]{1,500}$" }, { "type": "null" }] },
        "admitted_sequence": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
        "resulting_room_revision": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
        "resulting_transition_commitment_ref": { "anyOf": [{ "type": "string", "pattern": "^commitment://[^\\s]{1,500}$" }, { "type": "null" }] },
        "resulting_room_state_root": { "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
        "resulting_receipt_root": { "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
        "created_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:[.][0-9]+|)(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$" },
        "updated_at": { "anyOf": [{ "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:[.][0-9]+|)(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$" }, { "type": "null" }] },
        "admission_status": { "enum": ["proposed", "evaluating", "admitted", "rejected", "superseded", "revoked"] }
      },
      "allOf": [
        {
          "if": { "properties": { "admission_status": { "enum": ["admitted", "superseded", "revoked"] } } },
          "then": { "properties": {
            "admission_decision_ref": { "type": "string" },
            "admission_receipt_ref": { "type": "string" },
            "admitted_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "resulting_room_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "resulting_transition_commitment_ref": { "type": "string" },
            "resulting_room_state_root": { "type": "string" },
            "resulting_receipt_root": { "type": "string" },
            "updated_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:(?:[0-5][0-9]|60)(?:[.][0-9]+|)(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$" }
          } }
        },
        {
          "if": { "properties": { "admission_status": { "enum": ["proposed", "evaluating", "rejected"] } } },
          "then": { "properties": {
            "admitted_sequence": { "type": "null" },
            "resulting_room_revision": { "type": "null" },
            "resulting_transition_commitment_ref": { "type": "null" },
            "resulting_room_state_root": { "type": "null" },
            "resulting_receipt_root": { "type": "null" }
          } }
        }
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": { "const": "ioi.foundations.outcome-delta.v2" },
    "outcome_delta_id": { "type": "string", "pattern": "^outcome-delta://[^\\s]{1,500}$" },
    "work_subject_ref": { "type": "string", "pattern": "^(?:goal|automation-run|work-run|run|invocation|work-claim|attempt)://[^\\s]{1,500}$" },
    "outcome_room_ref": { "anyOf": [{ "type": "string", "pattern": "^outcome-room://[^\\s]{1,500}$" }, { "type": "null" }] },
    "room_admission": { "anyOf": [{ "$ref": "#/$defs/roomAdmission" }, { "type": "null" }] },
    "proposed_by_ref": { "type": "string", "pattern": "^(?:work-result|attempt|finding|participant-lease)://[^\\s]{1,500}$" },
    "target_ref": { "type": "string", "pattern": "^(?:frontier|finding|ontology|state|capability|policy|routing-prior|service)://[^\\s]{1,500}$" },
    "delta_kind": { "enum": ["create", "update", "supersede", "reject", "merge", "promote", "rollback", "course_correct", "close"] },
    "payload_ref": { "type": "string", "pattern": "^(?:artifact|patch|mapping|state-delta)://[^\\s]{1,500}$" },
    "precondition_and_invariant_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:policy|gate|state)://[^\\s]{1,500}$" } },
    "expected_effect_ref": { "anyOf": [{ "type": "string", "pattern": "^effect://[^\\s]{1,500}$" }, { "type": "null" }] },
    "verifier_and_acceptance_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:verifier-path|rubric|gate)://[^\\s]{1,500}$" } },
    "information_flow_label_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^ifc-label://[^\\s]{1,500}$" } },
    "status": { "enum": ["proposed", "evaluating", "admitted", "rejected", "superseded", "rolled_back"] }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome_room_ref": { "type": "string" } } },
      "then": { "properties": { "room_admission": { "$ref": "#/$defs/roomAdmission" } } },
      "else": { "properties": { "room_admission": { "type": "null" } } }
    }
  ]
}
