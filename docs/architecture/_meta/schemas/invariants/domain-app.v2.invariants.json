          },
          "receipt_obligations": {
            "path": "$.receipt_obligations"
          },
          "generated_artifact_refs": {
            "path": "$.generated_artifact_refs"
          },
          "surface_registration_ref": {
            "path": "$.surface_registration_ref"
          },
          "package_release_ref": {
