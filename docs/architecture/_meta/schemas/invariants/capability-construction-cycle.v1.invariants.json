          },
          "baseline_target_root": {
            "path": "$.baseline_target_root"
          },
          "resolved_component_snapshot_ref": {
            "path": "$.resolved_component_snapshot_ref"
          },
          "optimizer_ref": {
            "path": "$.optimizer_ref"
          },
          "search_policy_ref": {
