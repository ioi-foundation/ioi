{
  "$id": "invariant://ioi/foundations/participant-state-bundle/portable-room-binding/v2",
  "language": "ioi.portable-invariants.v1",
  "contract_id": "schema://ioi/foundations/participant-state-bundle/v2",
  "rules": [
    { "rule_id": "participant_state_bundle.room.matches_admission", "description": "The portable bundle and its CAS admission bind the same room.", "expression": { "operator": "fields_equal", "paths": ["$.outcome_room_ref", "$.room_admission.outcome_room_ref"] } },
    {
      "rule_id": "participant_state_bundle.issuer.matches_lease_or_room_system",
      "description": "A participant-requested export binds the exact lease; scheduling, expiry, revocation, quarantine, or room-close policy transitions may instead be issued by the exact room system.",
      "expression": { "operator": "any_of", "expressions": [
        { "operator": "fields_equal", "paths": ["$.participant_lease_ref", "$.room_admission.proposed_or_issued_by_ref"] },
        { "operator": "fields_equal", "paths": ["$.room_admission.room_system_id", "$.room_admission.proposed_or_issued_by_ref"] }
      ] }
    }
  ]
}
