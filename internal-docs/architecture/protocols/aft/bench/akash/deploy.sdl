---
# RES-P4.3 certified-provider SDL template.
#
# This file is hashed into the daemon-issued proposal and wallet challenge. It
# intentionally contains only secret sentinels. The Hypervisor resolves the two
# connector references after C2 intent commitment and injects the values only in
# daemon memory at the Akash execution boundary.

version: "2.0"

services:
  aft-bench:
    image: OWNER_APPROVED_IMAGE_REFERENCE
    credentials:
      host: OWNER_APPROVED_REGISTRY_HOST
      username: '__IOI_REGISTRY_USERNAME__'
      password: '__IOI_REGISTRY_PASSWORD__'
    env:
      - 'AFT_BENCH_CAMPAIGN_ID=OWNER_APPROVED_CAMPAIGN_ID'
      - 'AFT_BENCH_WARMUPS=OWNER_APPROVED_WARMUPS'
      - 'AFT_BENCH_REPEATS=OWNER_APPROVED_REPEATS'
      - 'IOI_AFT_BENCH_SCENARIO='
      - 'IOI_BENCH_COMMIT=OWNER_APPROVED_SOURCE_COMMIT'
      - 'IOI_BENCH_IMAGE_DIGEST=OWNER_APPROVED_IMAGE_DIGEST'
      - 'AFT_BENCH_PROTOCOL_VERSION=OWNER_APPROVED_PROTOCOL_VERSION'
      - 'AFT_RESULT_BEARER_TOKEN=__IOI_AFT_RESULT_BEARER_TOKEN__'
      - 'IOI_SECRET_CANARIES=OWNER_SEEDED_NON_SECRET_TEST_CANARY'
    expose:
      - port: 8080
        # The provider gateway terminates owner-pinned HTTPS on its public
        # listener and forwards the authenticated request to this HTTP port.
        # External port 80 is forbidden: the daemon never sends the result
        # bearer over plaintext and never falls back from HTTPS.
        as: 443
        to:
          - global: true

profiles:
  compute:
    aft-bench:
      resources:
        cpu:
          units: 8
        memory:
          size: 16Gi
        storage:
          size: 20Gi
  placement:
    pinned:
      attributes:
        host: akash
      pricing:
        aft-bench:
          denom: uact
          amount: OWNER_APPROVED_UACT_CEILING

deployment:
  aft-bench:
    pinned:
      profile: aft-bench
      count: 1
