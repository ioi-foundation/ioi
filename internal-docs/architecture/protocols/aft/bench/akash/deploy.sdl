---
# RES-P4.3 certified-provider SDL template.
#
# This file is hashed into the daemon-issued proposal and wallet challenge. It
# intentionally contains only secret sentinels. The Hypervisor resolves the two
# connector references after C2 intent commitment and injects the values only in
# daemon memory at the Akash execution boundary.

version: "2.0"

services:
  aft-bench:
    image: PRIVATE_REGISTRY/ORG/aft-bench@sha256:IMMUTABLE_IMAGE_DIGEST
    credentials:
      host: PRIVATE_REGISTRY
      username: '__IOI_REGISTRY_USERNAME__'
      password: '__IOI_REGISTRY_PASSWORD__'
    env:
      - 'AFT_BENCH_CAMPAIGN_ID=OWNER_APPROVED_CAMPAIGN_ID'
      - 'AFT_BENCH_WARMUPS=1'
      - 'AFT_BENCH_REPEATS=5'
      - 'IOI_AFT_BENCH_SCENARIO='
      - 'IOI_BENCH_IMAGE_DIGEST=sha256:IMMUTABLE_IMAGE_DIGEST'
      - 'AFT_RESULT_BEARER_TOKEN=__IOI_AFT_RESULT_BEARER_TOKEN__'
      - 'IOI_SECRET_CANARIES=OWNER_SEEDED_NON_SECRET_TEST_CANARY'
    expose:
      - port: 8080
        as: 80
        to:
          - global: true

profiles:
  compute:
    aft-bench:
      resources:
        cpu:
          units: 8
        memory:
          size: 16Gi
        storage:
          size: 20Gi
  placement:
    pinned:
      attributes:
        host: akash
      pricing:
        aft-bench:
          denom: uact
          amount: OWNER_APPROVED_UACT_CEILING

deployment:
  aft-bench:
    pinned:
      profile: aft-bench
      count: 1
