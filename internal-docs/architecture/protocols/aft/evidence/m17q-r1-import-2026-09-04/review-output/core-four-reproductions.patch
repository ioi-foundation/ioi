+        let protected_anchor: QuvHandoffStoreAnchorV0 = read_canonical(&anchor_path).unwrap();
+        assert_eq!(protected_anchor.generation, 0);
+
+        // All installed fields are derivable from the public source envelope.
+        // The attacker changes no protected-anchor byte and knows no custody key.
+        let forged_state = QuvHandoffStoreStateV0 {
+            magic: HANDOFF_STORE_MAGIC_V0,
+            schema: HANDOFF_STORE_SCHEMA_V0,
+            generation: 1,
