+    #[test]
+    fn repro_unauthenticated_one_generation_ahead_state_erases_conflict() {
+        let temp = TempDir::new().unwrap();
+        let state_path = temp.path().join("state/quv.scale");
+        let anchor_path = temp.path().join("anchor/quv.anchor");
+        let custody_key = [8; 32];
+        let signer = TestMember(account(1));
+        let x = candidate(QuvAuthorityModeV0::Owned, 10);
+
+        let mut member = DurableQuvMemberV0::open(&state_path, &anchor_path, custody_key).unwrap();
+        member
+            .process_push(
+                &QuvPushQueryV0 {
+                    verifier_nonce: [5; 32],
+                    candidate: x,
+                },
+                &AcceptCandidates,
+                &signer,
+            )
+            .unwrap();
+        drop(member);
+
+        // The attacker changes only the ordinary state file. It neither knows
+        // the custody key nor changes the separately protected anchor.
+        let protected_anchor: QuvStoreAnchorV0 = read_canonical(&anchor_path).unwrap();
+        assert_eq!(protected_anchor.generation, 1);
+        let forged_state = QuvStoreStateV0 {
+            magic: STORE_MAGIC_V0,
+            schema: STORE_SCHEMA_V0,
+            generation: protected_anchor.generation + 1,
+            previous_head: protected_anchor.head,
+            slots: BTreeMap::new(),
+        };
+        std::fs::write(
+            &state_path,
+            codec::to_bytes_canonical(&forged_state).unwrap(),
+        )
+        .unwrap();
+
+        // open() mistakes the unauthenticated bytes for its honest crash
+        // window and authenticates them by advancing the protected anchor.
+        let mut recovered =
+            DurableQuvMemberV0::open(&state_path, &anchor_path, custody_key).unwrap();
+        assert_eq!(recovered.generation(), 2);
+        let blessed_anchor: QuvStoreAnchorV0 = read_canonical(&anchor_path).unwrap();
+        assert_eq!(blessed_anchor.generation, 2);
+        assert_eq!(blessed_anchor.head, store_head(&forged_state).unwrap());
+
+        let y = candidate(QuvAuthorityModeV0::Owned, 11);
+        let reply_y = recovered
+            .process_push(
+                &QuvPushQueryV0 {
+                    verifier_nonce: [6; 32],
+                    candidate: y.clone(),
+                },
+                &AcceptCandidates,
+                &signer,
+            )
+            .unwrap();
+        assert_eq!(reply_y.complete_snapshot, vec![y]);
+    }
