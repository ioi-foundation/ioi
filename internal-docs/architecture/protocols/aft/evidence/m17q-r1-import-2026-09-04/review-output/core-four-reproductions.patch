+        let temp = TempDir::new().unwrap();
+        let state_path = temp.path().join("handoff/state.scale");
+        let anchor_path = temp.path().join("handoff-anchor/state.anchor");
+        let custody_key = [9; 32];
+        drop(DurableQuvHandoffV0::open(
