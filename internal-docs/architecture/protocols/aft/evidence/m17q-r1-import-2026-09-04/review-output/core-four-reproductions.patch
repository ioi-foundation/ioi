+        let correct_public = correct_key.public_key().to_bytes();
+        let correct_hash =
+            account_id_from_key_material(SignatureSuite::ML_DSA_44, &correct_public).unwrap();
+        let correct = AccountId(correct_hash);
+
+        let mut validators = vec![
+            ValidatorV1 {
+                account_id: owner,
+                weight: 1,
+                consensus_key: ActiveKeyRecord {
+                    suite: SignatureSuite::ML_DSA_44,
+                    public_key_hash: owner_hash,
+                    since_height: 1,
+                },
+            },
+            ValidatorV1 {
+                account_id: correct,
+                weight: 1,
+                consensus_key: ActiveKeyRecord {
+                    suite: SignatureSuite::ML_DSA_44,
+                    public_key_hash: correct_hash,
+                    since_height: 1,
+                },
+            },
+        ];
+        validators.sort_by(|left, right| left.account_id.cmp(&right.account_id));
+        let set = ValidatorSetV1 {
+            effective_from_height: 1,
+            total_weight: 2,
+            validators,
+        };
+        let configuration_root = ioi_types::app::canonical_validator_set_hash(&set).unwrap();
+        let mut keys = super::super::authenticated_quorum::ValidatorKeyRegistry::new();
+        keys.learn_raw_public_key(SignatureSuite::ML_DSA_44, &owner_public)
+            .unwrap();
+        keys.learn_raw_public_key(SignatureSuite::ML_DSA_44, &correct_public)
+            .unwrap();
+        let validator =
+            RootedQuvCandidateValidatorV0::new(&set, &keys, 1, [2; 32], [6; 32], Some(owner))
+                .unwrap();
+        let reply_verifier = RootedQuvReplyVerifierV0::new(&validator);
+        let correct_signer = MldsaTestMember {
+            account: correct,
+            keypair: correct_key,
+        };
+
+        let mut x = QuvCandidateV0 {
+            slot: QuvSlotV0 {
+                configuration_root,
+                policy_root: [6; 32],
+                network_id: [2; 32],
+                domain_id: [3; 32],
+                slot: 7,
+                predecessor: [4; 32],
+                authority_mode: QuvAuthorityModeV0::Owned,
+            },
+            payload_hash: [10; 32],
+            authorizer: owner,
+            authority_signature: Vec::new(),
+        };
+        x.authority_signature = owner_key
+            .sign(&quv_candidate_authority_signing_bytes(&x).unwrap())
+            .unwrap()
+            .to_bytes();
+        let mut y = x.clone();
+        y.slot.predecessor = [5; 32];
+        y.payload_hash = [11; 32];
+        y.authority_signature = owner_key
+            .sign(&quv_candidate_authority_signing_bytes(&y).unwrap())
+            .unwrap()
+            .to_bytes();
+        validator.validate_candidate(&x).unwrap();
+        validator.validate_candidate(&y).unwrap();
+
+        let temp = TempDir::new().unwrap();
+        let mut member = open_member(&temp);
+        let members = BTreeSet::from([owner, correct]);
+        let request_x = QuvPushQueryV0 {
+            verifier_nonce: [1; 32],
+            candidate: x.clone(),
+        };
+        let reply_x = member
+            .process_push(&request_x, &validator, &correct_signer)
+            .unwrap();
+        assert_eq!(reply_x.complete_snapshot, vec![x.clone()]);
+        let mut operation_x = QuvOnlineOperationV0::start(
+            request_x,
+            members.clone(),
+            Duration::from_secs(1),
+            Duration::from_secs(1),
+        )
+        .unwrap();
+        operation_x.observe_reply(reply_x);
+        let accepted_x = operation_x
+            .finish_at(Duration::from_secs(1), &validator, &reply_verifier)
+            .unwrap();
+
+        let request_y = QuvPushQueryV0 {
+            verifier_nonce: [2; 32],
+            candidate: y.clone(),
+        };
+        let reply_y = member
+            .process_push(&request_y, &validator, &correct_signer)
+            .unwrap();
+        assert_eq!(reply_y.complete_snapshot, vec![y.clone()]);
+        let mut operation_y = QuvOnlineOperationV0::start(
+            request_y,
+            members,
+            Duration::from_secs(1),
+            Duration::from_secs(1),
