+        let status = quv_operation_failure_status(typed);
+        assert_eq!(status.code(), tonic::Code::Aborted);
+        assert_eq!(
+            status.metadata().get("ioi-quv-refusal").unwrap(),
+            "conflict-disclosed-v0"
+        );
