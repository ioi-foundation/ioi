const CLEANUP_SCHEMA = "ioi.autopilot.gui-chat-ux-campaign.process-cleanup.v1";

// A closed key set, because "does this file assert something" must be decidable
// from the bytes rather than from a reader's impression of them.
const CLAIM_KEYS = [
  "verdict",
  "status",
  "summary",
  "ok",
  "recommendation",
  "targetAchieved",
];

const CUSTODY_RECORD = "m0-overlay-member-custody-and-disposition-successor";
const CLAIM_SUCCESSOR_RECORD = "m0-retired-campaign-claim-successor";

// --- member facts read from the bytes themselves ---------------------------

export function declaredSchema(body, id) {
  if (!id.endsWith(".json") || body === null) return null;
  try {
    const j = JSON.parse(body);
    const v = j.schemaVersion ?? j.schema_version ?? null;
    return typeof v === "string" && v.length > 0 ? v : null;
  } catch {
    return null;
  }
}

export function claimBearing(body, id) {
  if (body === null) return false;
  if (id.endsWith(".json")) {
    try {
      const j = JSON.parse(body);
      return CLAIM_KEYS.some((k) => Object.prototype.hasOwnProperty.call(j, k));
    } catch {
      return false;
    }
  }
  const heading = body.split("\n").find((l) => l.startsWith("# ")) ?? "";
  return /\b(verdict|audit)\b/iu.test(heading);
}

// --- the executable family rules -------------------------------------------
//
