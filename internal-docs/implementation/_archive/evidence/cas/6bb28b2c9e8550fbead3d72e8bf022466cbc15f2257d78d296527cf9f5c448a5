// --- git-history producer evidence (the slow input) ------------------------

function git(args, opts = {}) {
  return execFileSync("git", args, {
    cwd: REPO_ROOT,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
    maxBuffer: 1024 * 1024 * 256,
    ...opts,
  });
}

function gitQuiet(args) {
  try {
    return git(args);
  } catch {
    return "";
  }
}

// Every unique (blob, path) pair in the whole object graph, restricted to text
// paths OUTSIDE docs/evidence. Excluding docs/evidence is not a convenience: a
// piece of retained evidence naming another piece of retained evidence is a
// cross-reference, not a producer, and counting it would let the evidence
// attribute itself.
function historicalBlobs() {
  const out = new Map();
  const walk = gitQuiet(["rev-list", "--all", "--objects"]);
  for (const line of walk.split("\n")) {
    const sp = line.indexOf(" ");
    if (sp < 0) continue;
    const sha = line.slice(0, sp);
    const rel = line.slice(sp + 1);
    if (rel.startsWith("docs/evidence/")) continue;
    if (!/\.(mjs|js|ts|tsx|json|md|sh|rs|toml|yml|yaml)$/u.test(rel)) continue;
    if (!out.has(sha)) out.set(sha, rel);
  }
  return out;
}

function scanBlobsFor(needles, blobs) {
  return new Promise((resolve, reject) => {
    const hits = new Map();
    for (const n of needles) hits.set(n, new Set());
    const child = spawn("git", ["cat-file", "--batch"], { cwd: REPO_ROOT });
    let buf = Buffer.alloc(0);
    let pending = null;
    child.stdout.on("data", (chunk) => {
      buf = Buffer.concat([buf, chunk]);
      for (;;) {
        if (!pending) {
          const nl = buf.indexOf(0x0a);
          if (nl < 0) return;
          const header = buf.slice(0, nl).toString("utf8");
          buf = buf.slice(nl + 1);
          const parts = header.split(" ");
          if (parts.length < 3) continue;
          pending = { sha: parts[0], size: Number(parts[2]) };
        }
        if (buf.length < pending.size + 1) return;
        const body = buf.slice(0, pending.size).toString("utf8");
        buf = buf.slice(pending.size + 1);
        const rel = blobs.get(pending.sha);
        if (rel) for (const n of needles) if (body.includes(n)) hits.get(n).add(rel);
        pending = null;
      }
    });
    child.on("error", reject);
    child.on("close", () => resolve(hits));
    for (const sha of blobs.keys()) child.stdin.write(`${sha}\n`);
    child.stdin.end();
  });
}

// Records are asked for on one line with an unambiguous separator: a commit
// subject can contain anything a human types, including the tab and pipe the
// obvious separators would use.
const LOG_SEP = "";

function presentAt(commit, rel) {
  try {
    git(["cat-file", "-e", `${commit}:${rel}`]);
    return true;
  } catch {
    return false;
  }
}

// FOLLOW THE REBIND CHAIN TO A TERMINAL FATE.
//
// `--diff-filter=D` alone reports a rename as a deletion, so a producer that
// was renamed and only later deleted looks RETIRED at its first locator when it
// was merely REBOUND there. That is exactly the confusion the accepted
// source-level correction at the bound commit calls out: a rebind changes a
// locator, a retirement ends an identity, and a disposition resting on "the
// producer is gone" has to say which. So the removing commit is re-read with
// `-M`; if this path was a rename SOURCE the walk continues at the target, and
// only an outright delete — or survival in the bound tree — terminates it.
//
// It matters concretely. The producer behind the largest disposition family was
// renamed once before being deleted; read without following, its fate would be
// recorded as a rebind and the retirement that actually ended it would appear
// nowhere.
function producerFate(producerPath, boundCommit) {
  const rebinds = [];
  let current = producerPath;
  for (let hop = 0; hop < 16; hop += 1) {
    if (presentAt(boundCommit, current)) {
      return {
        present_in_bound_tree: true,
        terminal_path: current,
        terminal_removal: null,
        rebind_chain: rebinds,
      };
    }
    const line = gitQuiet([
      "log",
      "--all",
      "--diff-filter=D",
      "--date=short",
      "--format=%H%x01%s%x01%an%x01%ad",
      "--max-count=1",
      "--",
      current,
    ]).trim();
    if (!line) {
      return {
        present_in_bound_tree: false,
        terminal_path: current,
        terminal_removal: null,
        rebind_chain: rebinds,
      };
    }
    const [commit, subject, author, date] = line.split(LOG_SEP);
    const renameLine = gitQuiet(["show", "-M", "--name-status", "--format=", commit])
      .split("\n")
      .find((l) => /^R\d*\t/u.test(l) && l.split("\t")[1] === current);
    if (renameLine) {
      const target = renameLine.split("\t")[2];
      rebinds.push({
        from: current,
        to: target,
        commit,
        commit_short: commit.slice(0, 9),
        subject,
        author,
        date,
        kind: "rename_rebind",
      });
      current = target;
      continue;
    }
    return {
      present_in_bound_tree: false,
      terminal_path: current,
      terminal_removal: {
        commit,
        commit_short: commit.slice(0, 9),
        subject,
        author,
        date,
        kind: "retirement",
      },
      rebind_chain: rebinds,
    };
  }
  // Unterminated is reported, never rounded to "retired". A producer whose fate
  // cannot be resolved cannot support a disposition that rests on it.
  return {
    present_in_bound_tree: false,
    terminal_path: current,
    terminal_removal: null,
    rebind_chain: rebinds,
    unresolved: "rebind chain did not terminate within 16 hops",
  };
}

async function buildProducerEvidence() {
  const manifest = readJson(path.join(ESTATE_ROOT, OVERLAY_REL));
  const bindings = readJson(path.join(ESTATE_ROOT, BINDINGS_REL));
  const boundCommit = manifest.bound_git_tree.commit;

  const members = bindings.bindings.map((b) => {
    const abs = path.join(REPO_ROOT, b.id);
    const body = fs.existsSync(abs) ? fs.readFileSync(abs, "utf8") : null;
    return {
      id: b.id,
      base: b.id.split("/").pop(),
      schema: declaredSchema(body, b.id),
    };
  });

  const needles = new Set();
  for (const m of members) {
    needles.add(m.id);
    needles.add(m.base);
    if (m.schema) needles.add(m.schema);
  }

  progress(`scanning git history for ${needles.size} literal(s) naming ${members.length} overlay member(s)`);
  const blobs = historicalBlobs();
  progress(`  ${blobs.size} unique historical text blob(s) outside docs/evidence`);
  const hits = await scanBlobsFor([...needles], blobs);

  const producerPaths = new Set();
  const memberRows = [];
  for (const m of members) {
    const byPath = [...(hits.get(m.id) ?? [])].sort();
    const byBase = [...(hits.get(m.base) ?? [])].sort();
    const bySchema = m.schema ? [...(hits.get(m.schema) ?? [])].sort() : [];
    for (const p of [...byPath, ...byBase, ...bySchema]) producerPaths.add(p);
    memberRows.push({
      id: m.id,
      declared_schema: m.schema,
      named_by_path: byPath,
      named_by_basename: byBase,
      named_by_declared_schema: bySchema,
    });
  }

  const producers = [...producerPaths].sort().map((p) => ({
    path: p,
    class: p.startsWith("scripts/")
      ? "producing_script"
      : p.startsWith(".internal/plans/")
      ? "commissioning_plan"
      : "other_tracked_reference",
    fate: producerFate(p, boundCommit),
  }));

  const doc = {
    evidence_format: "ioi.program.canon_overlay_producer_evidence.v1",
    role:
      "The git-history producer evidence behind program/canon-overlay-dispositions.v1.json. For every bound overlay member it records which tracked blobs ANYWHERE in this repository's history literally name it — by exact path, by basename, or by the schemaVersion the member's own bytes declare — and, for each such producer, whether it survives in the bound tree and which commit removed it.",
    generated_by:
      "node internal-docs/implementation/tools/derive-overlay-dispositions.mjs --scan",
    derived_not_authored:
      "Every field comes from `git rev-list --all --objects`, `git cat-file --batch`, `git log --diff-filter=D`, and `git show -M`. Nothing is asserted about what a producer did; only that its bytes name this member and what git records about its fate.",
    why_this_is_not_self_attribution:
      "The scan EXCLUDES docs/evidence entirely. Retained evidence citing other retained evidence is a cross-reference, not a producer, and counting it would let the evidence answer the question that is being asked about it.",
    bound_git_tree: manifest.bound_git_tree,
    binds_manifest: {
      path: OVERLAY_REL,
      manifest_sha256: manifest.manifest_sha256,
    },
    producer_classes: {
      producing_script:
        "A tracked script under scripts/. It emitted the bytes or the schema the bytes declare.",
      commissioning_plan:
        "A tracked plan under .internal/plans/. It commissioned the campaign that produced the bytes and names the artifact by path. Weaker than a producing script and recorded as such.",
      other_tracked_reference:
        "Any other tracked path naming the member — canon, a registry, or the package manifest.",
    },
    fate_model: {
      rename_rebind:
        "The removing commit recorded this path as a rename SOURCE, so the producer was REBOUND to a new locator rather than retired. Derived from `git show -M`, never assumed, and the walk continues at the target: a rebind is a step in the chain, never its end.",
      retirement:
        "The removing commit deleted the path outright and recorded no rename source. This is the only thing that TERMINATES a chain in absence.",
      present_in_bound_tree:
        "The chain terminates in a producer that still exists at the bound commit, possibly at a rebound locator. That producer is alive and the evidence is not orphaned.",
      unresolved:
        "The chain neither survives nor reaches an outright delete. It is reported as unresolved and NEVER rounded to retired; a disposition that rests on a producer's fate cannot rest on an unresolved one.",
    },
    counts: {
      members: memberRows.length,
      producers: producers.length,
      members_with_a_named_producer: memberRows.filter(
        (m) =>
          m.named_by_path.length + m.named_by_basename.length +
              m.named_by_declared_schema.length > 0,
      ).length,
      producers_surviving_in_bound_tree: producers.filter((p) => p.fate.present_in_bound_tree).length,
      producers_terminally_retired: producers.filter((p) => p.fate.terminal_removal !== null).length,
      producers_rebound_at_least_once: producers.filter((p) => p.fate.rebind_chain.length > 0).length,
      producers_unresolved: producers.filter(
        (p) => !p.fate.present_in_bound_tree && p.fate.terminal_removal === null,
      ).length,
    },
    nonclaim:
      "Naming a producer asserts that its bytes contained this literal and that git records its fate. It asserts nothing about whether the producer was correct, whether the evidence it wrote is true, or whether anything it proved still holds.",
    producers,
    members: memberRows,
  };
  doc.producer_evidence_sha256 = selfDigest(doc, "producer_evidence_sha256");
  return doc;
}

export function selfDigest(doc, key) {
  const body = { ...doc };
  delete body[key];
  return sha256Text(JSON.stringify(body, null, 2));
}

// --- live inbound-reference proof ------------------------------------------
//
// Recomputed on every derivation rather than cached. A retirement rests on
// "nothing cites this", and a cached answer to that question is a claim about
// the past wearing the present tense.

function inboundRefs(memberId, boundCommit) {
  const needle = memberId.split("/").pop();
  const boundTree = gitQuiet([
    "grep",
    "-l",
    "-F",
    "--",
    needle,
    boundCommit,
    "--",
    ".",
    ":!docs/evidence",
  ])
    .split("\n")
    .map((l) => l.trim())
    .filter(Boolean)
    .map((l) => (l.startsWith(`${boundCommit}:`) ? l.slice(boundCommit.length + 1) : l));

  const grepIn = (root) => {
    try {
      return execFileSync("grep", ["-rlF", "--binary-files=without-match", "--", needle, root], {
        cwd: REPO_ROOT,
        encoding: "utf8",
        stdio: ["ignore", "pipe", "ignore"],
        maxBuffer: 1024 * 1024 * 64,
      })
        .split("\n")
        .map((l) => l.trim())
        .filter(Boolean);
    } catch {
      return [];
    }
  };

  const estate = [];
  for (const root of ESTATE_REL_ROOTS) {
    const start = path.join(ESTATE_ROOT, root);
    if (!fs.existsSync(start)) continue;
    for (const hit of grepIn(start)) {
      const estateRel = path.relative(ESTATE_ROOT, path.resolve(REPO_ROOT, hit));
      if (isSelfEnumeration(estateRel)) continue;
      estate.push(path.relative(REPO_ROOT, path.resolve(REPO_ROOT, hit)));
    }
  }

  // A member matching its own basename is not a citation OF itself.
  const retained = grepIn("docs/evidence")
    .map((p) => path.relative(REPO_ROOT, path.resolve(REPO_ROOT, p)))
    .filter((p) => p !== memberId);

  return {
    bound_git_tree: boundTree.sort(),
    canonical_estate: [...new Set(estate)].sort(),
    retained_evidence: [...new Set(retained)].sort(),
  };
}

// The estate roots a record, ledger, module, stage, or retained exit log can
// live in. `tools/` is deliberately absent: a checker naming a subject is a
// checker, not a citation that keeps the subject alive.
const ESTATE_REL_ROOTS = ["work-items", "stages", "modules", "evidence", "program"];

export function isSelfEnumeration(estateRel) {
  return SELF_ENUMERATION_PATHS.some((p) =>
    p.endsWith("/") ? estateRel.startsWith(p) : estateRel === p
  );
}

// --- the ledger ------------------------------------------------------------

function stageIsOpen(stageId) {
  const sequence = readJson(path.join(ESTATE_ROOT, "program", "sequence.v1.json"));
  const stage = (sequence.stages ?? []).find((s) => s.id === stageId);
  if (!stage) return false;
  const aggregate = stage.exit_gate?.aggregate_work_item_id;
  if (!aggregate) return false;
  for (const dir of ["active", "proposed"]) {
    const abs = path.join(ESTATE_ROOT, "work-items", dir, `${aggregate}.v1.json`);
    if (fs.existsSync(abs)) return readJson(abs).status !== "verified";
  }
  return false;
}

function recordOnDisk(workItemId) {
  for (const dir of ["active", "proposed"]) {
    const abs = path.join(ESTATE_ROOT, "work-items", dir, `${workItemId}.v1.json`);
    if (fs.existsSync(abs)) {
      const rec = readJson(abs);
      return {
        work_item_id: workItemId,
        record_path: path.relative(REPO_ROOT, abs),
        stage_id: rec.stage_id,
        status: rec.status,
        stage_open: stageIsOpen(rec.stage_id),
      };
    }
  }
  return { work_item_id: workItemId, record_path: null, stage_id: null, status: null, stage_open: false };
}

// --- the owner-ruling index ------------------------------------------------
//
// A ruling is read, never inferred. It is indexed BY PATH AND BY DIGEST
// TOGETHER, because a decision about specific bytes must not survive those bytes
// changing: if the member at the ruled path no longer carries the ruled digest,
// the decision does not apply and the member falls back to the derivation — and,
// where the derivation has nothing, back to a withheld attribution. Inheriting a
// decision about different bytes is exactly the failure this indexing prevents.
export function indexOwnerRulings(doc) {
  const byPath = new Map();
  const collisions = [];
  for (const ruling of doc?.rulings ?? []) {
    for (const decision of ruling.decisions ?? []) {
      if (!decision.bound_path || !decision.bound_sha256) continue;
      if (byPath.has(decision.bound_path)) {
        collisions.push(decision.bound_path);
        continue;
      }
      byPath.set(decision.bound_path, {
        ruling_id: ruling.ruling_id,
        ruling_ref: ruling.ruling_ref,
        dated: ruling.dated,
        ruled_by: ruling.ruled_by,
        evidentiary_restriction: ruling.evidentiary_restriction,
        retention: ruling.retention,
        not_a_family_rule: ruling.not_a_family_rule,
        decision,
      });
    }
  }
  return { byPath, collisions };
}

function loadOwnerRulings() {
  const abs = path.join(ESTATE_ROOT, OWNER_RULINGS_REL);
  if (!fs.existsSync(abs)) return { doc: null, index: { byPath: new Map(), collisions: [] } };
  const doc = readJson(abs);
  return { doc, index: indexOwnerRulings(doc) };
}

function buildContext() {
  const manifest = readJson(path.join(ESTATE_ROOT, OVERLAY_REL));
  const bindings = readJson(path.join(ESTATE_ROOT, BINDINGS_REL));
  const producerDoc = readJson(path.join(ESTATE_ROOT, PRODUCERS_REL));
  const rulings = loadOwnerRulings();
  const boundCommit = manifest.bound_git_tree.commit;

  const bindingById = new Map(bindings.bindings.map((b) => [b.id, b]));
  const producerRowById = new Map(producerDoc.members.map((m) => [m.id, m]));
  const producerByPath = new Map(producerDoc.producers.map((p) => [p.path, p]));
  const memberIds = new Set(bindings.bindings.map((b) => b.id));

  const bodyCache = new Map();
  const readBody = (id) => {
    if (!bodyCache.has(id)) {
      const abs = path.join(REPO_ROOT, id);
      bodyCache.set(id, fs.existsSync(abs) ? fs.readFileSync(abs, "utf8") : null);
    }
    return bodyCache.get(id);
  };

  const inboundCache = new Map();
  const inboundFor = (id) => {
    if (!inboundCache.has(id)) {
      inboundCache.set(id, inboundRefs(id, boundCommit));
    }
    return inboundCache.get(id);
  };

  const inBoundTreeCache = new Map();

  return {
    manifest,
    bindings,
    producerDoc,
    ownerRulingDoc: rulings.doc,
    ownerRulingIndex: rulings.index,
    // A ruling applies ONLY when the path AND the digest both match. The digest
    // compared is the one the frozen manifest bound, which is the same digest the
    // bar re-checks against the bytes on disk.
    ownerRulingFor: (m) => {
      const hit = rulings.index.byPath.get(m.id);
      if (!hit) return null;
      const bound = bindingById.get(m.id);
      if (!bound || bound.sha256 !== hit.decision.bound_sha256) return null;
      return hit;
    },
    ownerRulingDigestMismatch: (m) => {
      const hit = rulings.index.byPath.get(m.id);
      if (!hit) return null;
      const bound = bindingById.get(m.id);
      if (bound && bound.sha256 === hit.decision.bound_sha256) return null;
      return { ruled: hit.decision.bound_sha256, actual: bound?.sha256 ?? null };
    },
    boundCommit,
    memberIds,
    binding: (m) => bindingById.get(m.id),
    schema: (m) => declaredSchema(readBody(m.id), m.id),
    claimBearing: (m) => claimBearing(readBody(m.id), m.id),
    producersOf: (m) => {
      const row = producerRowById.get(m.id);
      if (!row) return [];
      return [
        ...new Set([
          ...row.named_by_path,
          ...row.named_by_basename,
          ...row.named_by_declared_schema,
        ]),
      ].sort();
    },
    fateOf: (p) => producerByPath.get(p)?.fate ?? null,
    // A producer supports a "the producer is gone" disposition ONLY when its
    // rebind chain terminates in an outright delete. Surviving at a rebound
    // locator, or an unresolved chain, does not.
    retiredProducer: (p) => (producerByPath.get(p)?.fate?.terminal_removal ?? null) !== null,
    inBoundTree: (p) => {
      if (!inBoundTreeCache.has(p)) {
        inBoundTreeCache.set(p, presentAt(boundCommit, p));
      }
      return inBoundTreeCache.get(p);
    },
    draftSibling: (m) => {
      const base = m.id.split("/").pop();
      if (!/draft/iu.test(base)) return null;
      const sibling = m.id.replace(/draft/iu, "final");
      return sibling !== m.id && memberIds.has(sibling) ? sibling : null;
    },
    inbound: inboundFor,
    inboundCount: (m) => {
      const r = inboundFor(m.id);
      return r.bound_git_tree.length + r.canonical_estate.length + r.retained_evidence.length;
    },
  };
}

function dispositionFor(ctx, member, rule) {
  const common = {
    id: member.id,
    sha256: ctx.binding(member).sha256,
    evidence_programme: ctx.binding(member).provenance.evidence_programme,
    disposition: rule.disposition,
    decision_source: "derived",
    family_rule: rule.rule_id,
    derivation:
      "The bytes on disk (declared schema, claim keys), program/canon-overlay-producer-evidence.v1.json (git-history producers, their rebind chains, and the commit that terminally removed each one), and a live inbound-reference proof. Never the enumeration, never the directory, never CAS membership.",
  };

  if (rule.disposition === "assigned_existing_owner") {
    const refs = ctx.binding(member).owner.tracked_producers.filter((p) => ctx.inBoundTree(p));
    return {
      ...common,
      owner: {
        kind: "existing_owner",
        refs,
        why:
          "Each ref is a path in the BOUND GIT TREE whose bytes literally name this evidence programme. It is a producer, consumer, or registry of the evidence — not the directory it sits in.",
      },
    };
  }

  if (rule.disposition === "assigned_new_successor") {
    const producers = ctx.producersOf(member);
    return {
      ...common,
      successor: {
        ...recordOnDisk(rule.owner),
        why:
          "The member asserts something and every producer or commissioning plan that named it has been removed from the bound tree by a named commit. The successor fences the claim; it does not adopt it.",
        derived_from: producers.map((p) => ({
          producer: p,
          class: ctx.producerDoc.producers.find((x) => x.path === p)?.class ?? null,
          fate: ctx.fateOf(p),
        })),
      },
    };
  }

  if (rule.disposition === "retained_nonclaim_evidence") {
    const producers = ctx.producersOf(member);
    return {
      ...common,
      custodian: {
        ...recordOnDisk(rule.owner),
        why:
          "An accountable record in the canonical estate holds these bytes. Custody is a named obligation, not a filing location.",
      },
      retention: {
        rule:
          "Retained in place under docs/evidence/ and content-addressed under _archive/evidence/cas/. Never deleted, never rewritten, never cited as proof of anything. The tracked retention control is the bound tree's own .gitignore, which excludes docs/evidence/* with a named allow-list; these bytes are outside that allow-list and are therefore host-local for as long as they exist.",
        review_trigger:
          "Re-decided when the custody record above reaches a terminal state, or when any inbound citation appears — at which point the member stops being non-claim evidence and needs a different disposition.",
        expiry: null,
      },
      grounds_no_claim: true,
      derived_from: producers.map((p) => ({
        producer: p,
        class: ctx.producerDoc.producers.find((x) => x.path === p)?.class ?? null,
        fate: ctx.fateOf(p),
      })),
    };
  }

  // retired
  const sibling = ctx.draftSibling(member);
  const producers = ctx.producersOf(member);
  // A REBIND IS NOT A RETIREMENT, so the tombstone carries the two separately.
  // Folding a rename into "retirement commits" would make a locator change look
  // like the end of an identity, which is the confusion this whole layer exists
  // to keep out.
  const removalCommits = [
    ...new Map(
      producers
        .map((p) => ctx.fateOf(p)?.terminal_removal)
        .filter(Boolean)
        .map((r) => [r.commit, r]),
    ).values(),
  ];
  const rebindCommits = [
    ...new Map(
      producers
        .flatMap((p) => ctx.fateOf(p)?.rebind_chain ?? [])
        .map((r) => [`${r.commit}:${r.from}`, r]),
    ).values(),
  ];
  return {
    ...common,
    tombstone: {
      recorded_in: `internal-docs/implementation/${LEDGER_REL}`,
      producer_removal_commits: removalCommits,
      producer_rebind_commits: rebindCommits,
      note:
        "The subject identity is retired. The bytes are NOT deleted: they stay on disk at their frozen digest, enumerated by the frozen overlay manifest and retained under _archive/evidence/cas/.",
      succession_model:
        "Retirement is recorded in the disposition/tombstone ledger and carried into the next immutable manifest version. A frozen manifest is never edited.",
      carried_into: SUCCESSOR_MANIFEST_REL,
      why_the_frozen_manifest_is_not_edited:
        "The v1 manifest's empty retired_members TRUTHFULLY RECORDS THE STATE FROZEN AT THAT DIGEST. Nothing was retired when it was frozen, so nothing belongs in that list; later retirement decisions do not rewrite history. Appending to it would make a frozen body say something it did not say at its digest, and would make the freeze that binds it a formality.",
    },
    inbound_reference_proof: {
      needle: member.id.split("/").pop(),
      scopes: ctx.inbound(member.id),
      total: ctx.inboundCount(member),
      method:
        "git grep -l -F over the bound commit excluding docs/evidence, grep -rlF over the canonical estate's record/stage/module/evidence/program roots minus the self-enumerations, and grep -rlF over the whole retained-evidence tree. Recomputed on every derivation; never cached.",
    },
    successor: {
      ref: sibling,
      kind: "superseding_overlay_member",
      why:
        "The FINAL counterpart of this draft is itself a bound overlay member at its own frozen digest, so nothing is lost by retiring the draft identity.",
    },
    rationale:
      "A draft superseded by a retained final, cited by nothing in the bound tree, the estate, or the retained-evidence tree. Its producer was removed from the bound tree by a named commit.",
    custodian: recordOnDisk(CUSTODY_RECORD),
  };
}

// AN OWNER RULING IS NINE DECISIONS, NOT ONE RULE.
//
// This function is called once per ruled member with that member's own decision
// record. It never sees the other decisions, it takes no predicate, and it
// carries `family_rule: null` — because the moment a ruling is expressible as a
// predicate over a directory or a programme, it stops being nine decisions and
// becomes one inference that eight of the nine never received.
//
// The entry also carries the ruling's evidentiary restriction as STRUCTURED
// DATA, not prose. These artifacts say "final", "verdict" and "proven" about
// themselves; custody of the bytes adopts none of it, and a consumer must be
// able to refuse a prohibited use without reading English.
function ownerRuledFor(ctx, member, hit) {
  const b = ctx.binding(member);
  const d = hit.decision;
  return {
    id: member.id,
    sha256: b.sha256,
    evidence_programme: b.provenance.evidence_programme,
    disposition: d.disposition,
    decision_source: "explicit_owner_ruling",
    family_rule: null,
    derivation:
      "NOT DERIVED. No tracked blob anywhere in this repository's history names this member by path, by basename, or by the schemaVersion its own bytes declare, so no predicate produced this disposition and none could. It is read from the owner-ruling ledger below, matched on this exact path AND this exact digest.",
    owner_ruling: {
      ruling_ref: hit.ruling_ref,
      ruling_id: hit.ruling_id,
      decision_id: d.decision_id,
      dated: hit.dated,
      ruled_by: hit.ruled_by,
      ledger_path: `internal-docs/implementation/${OWNER_RULINGS_REL}`,
      owner_rulings_sha256: ctx.ownerRulingDoc?.owner_rulings_sha256 ?? null,
      bound_path: d.bound_path,
      bound_sha256: d.bound_sha256,
      individual_decision: d.binds_exactly_one_subject,
      not_a_family_rule: hit.not_a_family_rule,
      why_no_derivation_was_available: d.why_no_derivation_was_available,
    },
    custodian: {
      ...recordOnDisk(d.custodian_work_item_id),
      why:
        "An accountable record in the canonical estate holds these bytes, named by the owner rather than found by a predicate. Custody is a named obligation, not a filing location.",
    },
    retention: {
      rule: hit.retention?.rule ?? null,
      review_trigger: hit.retention?.review_trigger ?? null,
      expiry: hit.retention?.expiry ?? null,
    },
    grounds_no_claim: true,
    grounds_no_claim_basis: {
      kind: "explicit_owner_ruling",
      bytes_contain_claim_language: claimBearing(
        fs.existsSync(path.join(REPO_ROOT, member.id))
          ? fs.readFileSync(path.join(REPO_ROOT, member.id), "utf8")
          : null,
        member.id,
      ),
      why:
        "`grounds_no_claim` states what THIS ESTATE asserts through this member, which is nothing. It never states that the artifact's own text is empty of assertions: several of these artifacts call themselves final, complete, or a verdict. That language is historical artifact content and the restriction below governs it.",
    },
    evidentiary_restriction: hit.evidentiary_restriction,
    derived_from: [],
  };
}

function unattributedFor(ctx, member, refusals) {
  const b = ctx.binding(member);
  const mismatch = ctx.ownerRulingDigestMismatch(member);
  return {
    id: member.id,
    sha256: b.sha256,
    evidence_programme: b.provenance.evidence_programme,
    disposition: "unattributed",
    decision_source: null,
    family_rule: null,
    ...(mismatch
      ? {
        owner_ruling_not_applied: {
          ruled_sha256: mismatch.ruled,
          actual_sha256: mismatch.actual,
          why:
            "An owner ruling names this path but binds a different digest. A decision about specific bytes does not survive those bytes changing, so it is NOT applied and the member returns to a withheld attribution rather than inheriting a decision about something else.",
        },
      }
      : {}),
    why_derivation_failed:
      refusals.length > 0
        ? refusals.map((r) => `${r.rule_id}: ${r.why}`).join(" | ")
        : "No tracked blob anywhere in this repository's history names this member — not by path, not by basename, and not by the schemaVersion its own bytes declare. The only remaining route to an owner would be the directory it sits in or the enumeration that lists it, and both are refused.",
    refused_shortcuts: [
      "attribution_directory_default: its sibling members' owner is not its owner",
      "attribution_baseline_self_reference: the enumeration that lists it is not its owner",
      "attribution_cas_membership: being retained is not being owned",
    ],
    nonclaim:
      "This is a WITHHELD attribution, not an assertion that none exists. It stays a certification blocker.",
  };
}

export function buildLedger() {
  const ctx = buildContext();
  const members = ctx.bindings.bindings.map((b) => ({ id: b.id }));

  const entries = [];
  const ruleState = new Map();
  for (const rule of FAMILY_RULES) {
    ruleState.set(rule.rule_id, { members: [], exceptions: [] });
  }

  const ruled = [];
  for (const member of members) {
    // AN OWNER RULING IS CONSULTED FIRST AND SEPARATELY. It is not a rule in the
    // ordered family list and it must never be reachable through one: a ruled
    // member never enters the loop below, so no family rule can claim it, count
    // it, or list it as an exception.
    const ruling = ctx.ownerRulingFor(member);
    if (ruling) {
      ruled.push({ id: member.id, decision_id: ruling.decision.decision_id });
      entries.push(ownerRuledFor(ctx, member, ruling));
      continue;
    }
    let owned = null;
    const refusals = [];
    for (const rule of FAMILY_RULES) {
      if (!rule.candidate(ctx, member)) continue;
      if (rule.qualifies(ctx, member)) {
        owned = rule;
        break;
      }
      const why = rule.refusal(ctx, member);
      refusals.push({ rule_id: rule.rule_id, why });
      ruleState.get(rule.rule_id).exceptions.push({ id: member.id, why });
    }
    if (owned) {
      ruleState.get(owned.rule_id).members.push(member.id);
      entries.push(dispositionFor(ctx, member, owned));
    } else {
      entries.push(unattributedFor(ctx, member, refusals));
    }
  }

  entries.sort((a, b) => (a.id < b.id ? -1 : 1));

  const counts = {
    members: entries.length,
    by_disposition: {},
    by_decision_source: {
      derived: entries.filter((e) => e.decision_source === "derived").length,
      explicit_owner_ruling: entries.filter((e) => e.decision_source === "explicit_owner_ruling")
        .length,
      none_withheld: entries.filter((e) => e.decision_source === null).length,
    },
  };
  for (const key of [...Object.keys(DISPOSITION_VOCABULARY), "unattributed"]) {
    counts.by_disposition[key] = 0;
  }
  for (const e of entries) counts.by_disposition[e.disposition] += 1;

  const doc = {
    evidence_format: "ioi.program.canon_overlay_dispositions.v1",
    role:
      "Exactly ONE disposition per bound canon-overlay member, derived from real evidence: the bytes' own declared schema, the git history of the producer that wrote them, the commit that removed that producer, and a live inbound-reference proof. It closes the attribution question the binding layer honestly left open, and it closes it OUTSIDE the index, because an index cannot own the subjects it enumerates.",
    generated_by:
      "node internal-docs/implementation/tools/derive-overlay-dispositions.mjs --write",
    derived_not_authored:
      "Every field is derived. Re-running --check re-derives and diffs byte-for-byte; a hand edit fails closed.",
    checked_by:
      "internal-docs/implementation/tools/check-overlay-dispositions.mjs",
    binds: {
      manifest: {
        path: OVERLAY_REL,
        manifest_sha256: ctx.manifest.manifest_sha256,
        never_edited:
          "The manifest is a frozen subject and this ledger changes not one byte of it. Its empty retired_members TRUTHFULLY RECORDS THE STATE FROZEN AT THAT DIGEST; later retirement decisions do not rewrite history.",
        succession_model:
          "Retirement is recorded in the disposition/tombstone ledger and carried into the next immutable manifest version. A frozen manifest is never edited.",
        carried_into: SUCCESSOR_MANIFEST_REL,
      },
      owner_rulings: {
        path: OWNER_RULINGS_REL,
        owner_rulings_sha256: ctx.ownerRulingDoc?.owner_rulings_sha256 ?? null,
        applied_decisions: ruled.length,
        role:
          "Read, never inferred. A decision applies only when this exact path carries this exact digest; where it does not, the member returns to a withheld attribution rather than inheriting a decision about different bytes.",
      },
      bindings: {
        path: BINDINGS_REL,
        bindings_sha256: ctx.bindings.bindings_sha256,
      },
      producer_evidence: {
        path: PRODUCERS_REL,
        producer_evidence_sha256: ctx.producerDoc.producer_evidence_sha256,
        regenerate_with:
          "node internal-docs/implementation/tools/derive-overlay-dispositions.mjs --scan",
      },
    },
    bound_git_tree: ctx.manifest.bound_git_tree,
    disposition_vocabulary: DISPOSITION_VOCABULARY,
    decision_source_vocabulary: DECISION_SOURCE_VOCABULARY,
    decision_source_is_not_cosmetic:
      "`derived` and `explicit_owner_ruling` are mutually exclusive and both directions are checked. A member the owner-ruling ledger binds may NEVER be reported as derived, and a member claiming a ruling the ledger does not bind at that exact path and digest may never be reported as ruled. Owner-ruled members carry family_rule: null and no family rule may enumerate them — a ruling stated as a predicate is one inference, not nine decisions.",
    owner_ruled_members: ruled,
    unattributed_is_not_a_disposition:
      "`unattributed` is the honest refusal to invent one. It is reported member by member with the reason derivation failed, it grants no coverage, and the bar treats it as a withheld verification that keeps the audit red.",
    non_attribution_patterns: NON_ATTRIBUTION_PATTERNS,
    self_enumeration_paths: SELF_ENUMERATION_PATHS,
    family_rules: FAMILY_RULES.map((r) => ({
      rule_id: r.rule_id,
      title: r.title,
      disposition: r.disposition,
      owner: r.owner,
      rationale: r.rationale,
      member_count: ruleState.get(r.rule_id).members.length,
      members: ruleState.get(r.rule_id).members,
      exception_count: ruleState.get(r.rule_id).exceptions.length,
      exceptions: ruleState.get(r.rule_id).exceptions,
    })),
    family_rule_contract:
      "A family attributes only when a deterministic predicate enumerates EVERY member it claims, the rule records its owner and rationale, and every candidate the predicate refused is exposed INDIVIDUALLY with the reason. Rules are ordered and first-match-wins, so no member can carry two dispositions.",
    counts,
    nonclaim:
      "A disposition says who is accountable for these bytes and on what terms. It asserts nothing about whether the evidence is correct, current, or sufficient, adopts no claim any member makes, grants no coverage to any canon subject, and advances no baseline. Where a member carries an evidentiary_restriction, that restriction governs what the bytes may be used for and is not softened by custody, retention, content addressing, a promotion event, or any bar in this estate passing.",
    entries,
  };
  doc.dispositions_sha256 = selfDigest(doc, "dispositions_sha256");
  return doc;
}

// --- entry point -----------------------------------------------------------

function argValue(name) {
  const i = process.argv.indexOf(`--${name}`);
  return i === -1 ? null : (process.argv[i + 1] ?? null);
}

async function main() {
  const scan = process.argv.includes("--scan");
  const write = process.argv.includes("--write");
  const check = process.argv.includes("--check");
  // --out writes the derived ledger to PRIVATE STAGING instead of the estate, so
  // a regenerated ledger can enter the canonical estate the only sanctioned way:
  // through a recorded promotion event. Without it the one artifact that says who
  // is accountable for 220 subjects would be the one artifact that could change
  // with no event at all.
  const out = argValue("out");
  if (!scan && !write && !check) {
    progress("usage: derive-overlay-dispositions.mjs --scan | --write [--out <path outside the estate>] | --check");
    process.exit(2);
  }
  if (out) {
    const resolved = path.resolve(out);
    if (resolved === ESTATE_ROOT || resolved.startsWith(`${ESTATE_ROOT}${path.sep}`)) {
      progress(
        `REFUSED: --out ${resolved} is INSIDE the canonical estate. --out exists so the ledger can be staged and promoted; writing it into the estate directly is the unrecorded write it avoids.`,
      );
      process.exit(1);
    }
  }

  if (scan) {
    const doc = await buildProducerEvidence();
    writeJsonDeterministic(path.join(ESTATE_ROOT, PRODUCERS_REL), doc);
    progress(
      `wrote ${PRODUCERS_REL}: ${doc.counts.members} member(s), ${doc.counts.members_with_a_named_producer} with a named producer, ${doc.counts.producers} producer path(s), ${doc.counts.producers_surviving_in_bound_tree} surviving in the bound tree`,
    );
    if (!write && !check) process.exit(0);
  }

  const abs = path.join(ESTATE_ROOT, LEDGER_REL);
  if (!fs.existsSync(path.join(ESTATE_ROOT, PRODUCERS_REL))) {
    progress(`${PRODUCERS_REL} is missing; run --scan first`);
    process.exit(1);
  }
  const doc = buildLedger();

  if (write) {
    const target = out ? path.resolve(out) : abs;
    writeJsonDeterministic(target, doc);
    const c = doc.counts.by_disposition;
    const s = doc.counts.by_decision_source;
    progress(
      `wrote ${out ? target : LEDGER_REL}: ${doc.counts.members} member(s) — ${c.assigned_existing_owner} existing owner, ${c.assigned_new_successor} new successor, ${c.retained_nonclaim_evidence} retained non-claim, ${c.retired} retired, ${c.unattributed} UNATTRIBUTED; decision source ${s.derived} derived / ${s.explicit_owner_ruling} explicit owner ruling / ${s.none_withheld} withheld`,
    );
    if (out) {
      progress(
        "  STAGED, NOT PROMOTED. These bytes have no authority until tools/promote-staged.mjs records an event for them.",
      );
    }
    process.exit(0);
  }

  if (!fs.existsSync(abs)) {
    progress(`${LEDGER_REL} is missing; run --write`);
    process.exit(1);
  }
  const onDisk = fs.readFileSync(abs, "utf8");
  const fresh = `${JSON.stringify(doc, null, 2)}\n`;
  const same = onDisk === fresh;
  progress(
    same
      ? `${LEDGER_REL} reproduces byte-for-byte (${doc.counts.members} members, ${doc.counts.by_disposition.unattributed} unattributed, ${doc.counts.by_decision_source.derived} derived, ${doc.counts.by_decision_source.explicit_owner_ruling} explicit owner ruling)`
      : `${LEDGER_REL} does NOT reproduce from a fresh derivation`,
  );
  process.exit(same ? 0 : 1);
}

if (import.meta.url === `file://${process.argv[1]}`) main();
