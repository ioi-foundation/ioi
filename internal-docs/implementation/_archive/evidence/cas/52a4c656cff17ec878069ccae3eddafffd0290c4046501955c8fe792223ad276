#!/usr/bin/env node
// Independently reviewed atomic phase-two successor admission.
// Dry-run is the default. --apply is refused until one independent binding
// names the exact frozen estate generation. Any failed transition, promotion,
// or final programme check restores every touched target, the promotion ledger,
// and the CAS prefix before returning failure.
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import process from "node:process";
import { execFileSync } from "node:child_process";
import {
  ESTATE_ROOT,
  REPO_ROOT,
  readJson,
  sha256File,
  writeJsonDeterministic,
} from "./lib/estate.mjs";
import {
  GENERATION_REL,
  PROMOTIONS_REL,
  REVIEW_BINDINGS_REL,
  validateReleaseGeneration,
} from "./lib/release-generation.mjs";

function run(command, args, options = {}) {
  return execFileSync(command, args, {
    cwd: REPO_ROOT,
    encoding: "utf8",
    stdio: options.capture === false ? "inherit" : ["ignore", "pipe", "pipe"],
    maxBuffer: 64 * 1024 * 1024,
  });
}

function walk(root) {
  const out = [];
  const stack = [root];
  while (stack.length > 0) {
    const dir = stack.pop();
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const abs = path.join(dir, entry.name);
      if (entry.isDirectory()) stack.push(abs);
      else if (entry.isFile()) out.push(path.relative(root, abs));
    }
  }
  return out.sort();
}

function trackedEstateFiles() {
  return walk(ESTATE_ROOT).filter((rel) =>
    rel !== PROMOTIONS_REL && !rel.startsWith("_archive/evidence/cas/"));
}

function snapshot(root) {
  const files = trackedEstateFiles();
  const digests = new Map();
  for (const rel of files) {
    const source = path.join(ESTATE_ROOT, rel);
    const target = path.join(root, rel);
    fs.mkdirSync(path.dirname(target), { recursive: true });
    fs.copyFileSync(source, target);
    digests.set(rel, sha256File(source));
  }
  return digests;
}

function currentDigests() {
  return new Map(trackedEstateFiles().map((rel) => [rel, sha256File(path.join(ESTATE_ROOT, rel))]));
}

function changedPaths(before, after) {
  return [...new Set([...before.keys(), ...after.keys()])]
    .filter((rel) => before.get(rel) !== after.get(rel))
    .sort();
}

function restoreTargets(paths, backupRoot, before) {
  for (const rel of paths) {
    const target = path.join(ESTATE_ROOT, rel);
    if (before.has(rel)) {
      fs.mkdirSync(path.dirname(target), { recursive: true });
      fs.copyFileSync(path.join(backupRoot, rel), target);
    } else if (fs.existsSync(target)) {
      fs.rmSync(target, { force: true });
    }
  }
}

function latestIndependentBinding(generationDigest, generation) {
  const reviewAbs = path.join(ESTATE_ROOT, REVIEW_BINDINGS_REL);
  if (!fs.existsSync(reviewAbs)) throw new Error(`${REVIEW_BINDINGS_REL} is absent`);
  const review = readJson(reviewAbs);
  const binding = review.bindings?.at(-1);
  if (!binding) throw new Error("release review ledger carries no binding");
  if (binding.estate_generation_sha256 !== generationDigest) throw new Error("independent binding does not name the exact current generation bytes");
  if (binding.independent_of_implementation !== true) throw new Error("reviewer did not affirm independence from implementation");
  if (binding.decision !== "approve_atomic_successor_batch") throw new Error(`review decision is ${binding.decision ?? "absent"}, not approve_atomic_successor_batch`);
  if (
    binding.git_commit !== generation.bound_git_tree.commit ||
    binding.docs_tree_sha !== generation.bound_git_tree.docs_tree_sha
  ) throw new Error("review binding Git tree does not match the generation");
  if (typeof binding.reviewer_ref !== "string" || binding.reviewer_ref.length < 8) throw new Error("review binding names no accountable reviewer");
  return binding;
}

function main() {
  const apply = process.argv.includes("--apply");
  const generationAbs = path.join(ESTATE_ROOT, GENERATION_REL);
  if (!fs.existsSync(generationAbs)) throw new Error(`${GENERATION_REL} is absent`);
  const generation = readJson(generationAbs);
  const validation = validateReleaseGeneration(generation, { phase: "pre" });
  if (validation.length > 0) throw new Error(`generation preflight refused:\n- ${validation.join("\n- ")}`);
  const generationDigest = sha256File(generationAbs);
  const binding = latestIndependentBinding(generationDigest, generation);

  // The same gate that will execute each transition must accept every frozen
  // result before a single write begins.
  for (const successor of generation.successors) {
    const result = path.join(ESTATE_ROOT, successor.certification_candidate_rel);
    run("node", [
      "internal-docs/implementation/tools/transition.mjs",
      successor.id,
      "verified",
      "--result",
      result,
    ]);
  }
  if (!apply) {
    process.stdout.write(`READY: ${generation.successors.length} successor transitions pass dry-run against generation ${generationDigest}; reviewer ${binding.reviewer_ref}; no bytes changed\n`);
    return;
  }

  const transactionRoot = fs.mkdtempSync(path.join(os.tmpdir(), "ioi-successor-batch-"));
  const backupRoot = path.join(transactionRoot, "before");
  const afterRoot = path.join(transactionRoot, "after");
  const promotionLedgerAbs = path.join(ESTATE_ROOT, PROMOTIONS_REL);
  const promotionBefore = fs.readFileSync(promotionLedgerAbs);
  const casRoot = path.join(ESTATE_ROOT, "_archive/evidence/cas");
  const casBefore = new Set(fs.existsSync(casRoot) ? fs.readdirSync(casRoot) : []);
  const before = snapshot(backupRoot);
  let changed = [];

  try {
    for (const successor of generation.successors) {
      run("node", [
        "internal-docs/implementation/tools/transition.mjs",
        successor.id,
        "verified",
        "--result",
        path.join(ESTATE_ROOT, successor.certification_candidate_rel),
        "--apply",
      ]);
    }

    const outputs = generation.admitted_outputs;
    for (const [sourceRel, destinationRel] of [
      [outputs.overlay, outputs.destination_overlay],
      [outputs.baseline, outputs.destination_baseline],
    ]) {
      const source = path.join(ESTATE_ROOT, sourceRel);
      const destination = path.join(ESTATE_ROOT, destinationRel);
      fs.mkdirSync(path.dirname(destination), { recursive: true });
      fs.copyFileSync(source, destination);
    }

    const holdRel = "_archive/holds/certification-hold.v1.json";
    const holdAbs = path.join(ESTATE_ROOT, holdRel);
    const hold = readJson(holdAbs);
    hold.state = "CLOSED";
    hold.closed_by = {
      transaction: "tools/transition-successor-batch.mjs",
      generation_sha256: generationDigest,
      reviewer_ref: binding.reviewer_ref,
      review_binding_id: binding.binding_id,
      git_commit: generation.bound_git_tree.commit,
      rule: "Closed only inside the atomic batch after all exact-input transitions succeeded; final check-program still had to pass or this write was rolled back.",
    };
    writeJsonDeterministic(holdAbs, hold);

    run("node", ["internal-docs/implementation/tools/canon-impact.mjs", "--write"]);
    run("node", ["internal-docs/implementation/tools/generate-now.mjs", "--write"]);

    const after = currentDigests();
    changed = changedPaths(before, after);
    for (const rel of changed) {
      const source = path.join(ESTATE_ROOT, rel);
      if (!fs.existsSync(source)) throw new Error(`transaction deleted ${rel}; deletion is outside this batch contract`);
      const target = path.join(afterRoot, rel);
      fs.mkdirSync(path.dirname(target), { recursive: true });
      fs.copyFileSync(source, target);
    }

    // Restore the authoritative targets to their reviewed prestate, then move
    // the exact staged poststate through the promotion event one target at a
    // time. This makes each prior_target_sha256 truthful.
    restoreTargets(changed, backupRoot, before);
    for (const rel of changed) {
      run("node", [
        "internal-docs/implementation/tools/promote-staged.mjs",
        "--from", path.join(afterRoot, rel),
        "--to", rel,
        "--reviewer-ref", binding.reviewer_ref,
        "--reason", `Atomic successor-release transaction ${generation.generation_id}: exact independently reviewed poststate.`,
        "--apply",
      ]);
    }

    const final = run("node", ["internal-docs/implementation/tools/check-program.mjs", "--json"]);
    const report = JSON.parse(final);
    if (report.result !== "PASS" || report.error_count !== 0 || report.skip_count !== 0) {
      throw new Error(`final check-program was ${report.result} with ${report.error_count} errors and ${report.skip_count} skips`);
    }
    process.stdout.write(`COMPLETE: admitted ${generation.successors.length} successors atomically; ${changed.length} estate targets promoted; check-program PASS; 0 errors; 0 skips; reviewer ${binding.reviewer_ref}\n`);
  } catch (error) {
    const now = currentDigests();
    restoreTargets([...new Set([...before.keys(), ...now.keys()])], backupRoot, before);
    fs.writeFileSync(promotionLedgerAbs, promotionBefore);
    if (fs.existsSync(casRoot)) {
      for (const name of fs.readdirSync(casRoot)) {
        if (!casBefore.has(name)) fs.rmSync(path.join(casRoot, name), { force: true });
      }
    }
    throw new Error(`atomic batch rolled back: ${error.message}`);
  } finally {
    fs.rmSync(transactionRoot, { recursive: true, force: true });
  }
}

try {
  main();
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exit(1);
}
