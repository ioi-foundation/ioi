    "check:shell-parity": "node scripts/verify-hypervisor-shell-parity.mjs",
    "test:product-shell-auth": "node --test scripts/product-shell-auth.test.mjs",
    "check:source-neutral": "node scripts/check-source-neutral.mjs"
