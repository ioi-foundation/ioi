    "check:operations-cockpit": "node scripts/verify-hypervisor-operations-cockpit.mjs",
    "check:projects-saga": "node scripts/verify-hypervisor-projects-saga.mjs",
    "check:model-route-authority": "node scripts/verify-hypervisor-model-route-authority.mjs",
    "check:model-router-decisions": "node scripts/verify-hypervisor-model-router-decisions.mjs",
