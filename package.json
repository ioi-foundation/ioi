{
  "name": "ioi-network-monorepo",
  "private": true,
  "workspaces": [
    "apps/aiagent-xyz",
    "apps/developers-ioi-ai",
    "apps/hypervisor",
    "apps/hypervisor-web",
    "apps/sas-xyz",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:hypervisor-app": "npm run dev --workspace=@ioi/hypervisor-app",
    "dev:hypervisor-web": "npm run dev --workspace=@ioi/hypervisor-web",
    "build:hypervisor-web": "npm run build --workspace=@ioi/hypervisor-web",
    "dev:hypervisor-code-editor-adapter-host": "node scripts/launch-hypervisor-code-editor-adapter-host.mjs",
    "dev:hypervisor-code-editor-adapter-host:wayland": "node scripts/launch-hypervisor-code-editor-adapter-host.mjs --ozone-platform=wayland",
    "dryrun:hypervisor-code-editor-adapter-host": "bash apps/hypervisor/scripts/dry-run-desktop.sh x11",
    "dryrun:hypervisor-code-editor-adapter-host:wayland": "bash apps/hypervisor/scripts/dry-run-desktop.sh wayland",
    "test:hypervisor-app-harness": "node --test scripts/lib/hypervisor-app-harness-contract.test.mjs",
    "test:hypervisor-app-clients": "node --test apps/hypervisor/surfaces/read-authority-clients.test.mjs",
    "test:hypervisor-route-shell": "node --test apps/hypervisor/scripts/v2-route-shell.test.mjs",
    "test:hypervisor-app-events": "node --test apps/hypervisor/surfaces/event-client.test.mjs",
    "test:hypervisor-scm-publication-client": "node --test scripts/lib/hypervisor-scm-publication-client.test.mjs",
    "test:hypervisor-domain-app-runtime": "node --test apps/hypervisor/scripts/domain-app-runtime-model.test.mjs",
    "test:vite-production-authority-scan": "node --test scripts/lib/vite-production-authority-scan.test.mjs",
    "check:shipped-products": "node scripts/validate-shipped-products.mjs",
    "check:surface-records": "node scripts/generate-hypervisor-surface-records.mjs --check",
    "test:shipped-products": "node --test scripts/lib/shipped-products-manifest.test.mjs",
    "build:agent-sdk": "npm run build --workspace=@ioi/agent-sdk",
    "test:agent-sdk": "npm test --workspace=@ioi/agent-sdk",
    "build:wallet-protocol": "npm run build --workspace=@ioi/wallet-protocol",
    "test:wallet-protocol": "npm test --workspace=@ioi/wallet-protocol",
    "build:wallet-sdk": "npm run build --workspace=@ioi/wallet-sdk",
    "test:wallet-sdk": "npm test --workspace=@ioi/wallet-sdk",
    "test:cursor-sdk-reference": "node --test scripts/lib/cursor-sdk-reference-contract.test.mjs",
    "test:rust-daemon-runtime-api": "node --test scripts/lib/rust-daemon-lifecycle-contract.test.mjs scripts/lib/rust-daemon-doctor-authority-contract.test.mjs scripts/lib/rust-daemon-coding-tools-contract.test.mjs scripts/lib/rust-daemon-workflow-edit-contract.test.mjs scripts/lib/rust-daemon-workflow-edit-approval-contract.test.mjs scripts/lib/rust-daemon-mcp-control-contract.test.mjs scripts/lib/rust-daemon-computer-use-contract.test.mjs scripts/lib/rust-daemon-computer-use-native-browser-contract.test.mjs scripts/lib/rust-daemon-computer-use-visual-gui-contract.test.mjs scripts/lib/rust-daemon-mcp-discovery-contract.test.mjs",
    "test:sdk-live-daemon": "npm test --workspace=@ioi/agent-sdk",
    "test:workflow-compositor-dogfood": "node --test scripts/lib/rust-daemon-workflow-edit-contract.test.mjs scripts/lib/rust-daemon-workflow-edit-approval-contract.test.mjs",
    "generate:runtime-action-contracts": "node scripts/generate-runtime-action-contracts.mjs --write",
    "generate:architecture-contracts": "node scripts/generate-architecture-contracts.mjs --write",
    "check:architecture-contracts": "node scripts/generate-architecture-contracts.mjs --check",
    "check:mutation-foundation": "node scripts/audit-daemon-mutation-foundation.mjs --check",
    "check:mutation-handlers": "node scripts/audit-daemon-mutation-handlers.mjs --check",
    "check:admission-evidence": "node scripts/audit-admission-evidence-provenance.mjs --check",
    "check:workload-bound-effect-boundary": "node scripts/check-workload-bound-effect-boundary.mjs",
    "mutate:workload-bound-effect-boundary": "node scripts/check-workload-bound-effect-boundary.mjs --mutation",
    "check:device-custody-boundary": "node scripts/check-device-custody-boundary.mjs",
    "mutate:device-custody-boundary": "node scripts/check-device-custody-boundary.mjs --mutation",
    "check:secret-custody-profile": "node scripts/check-secret-custody-profile.mjs",
    "mutate:secret-custody-profile": "node scripts/check-secret-custody-profile.mjs --mutation",
    "check:standing-authority": "node scripts/check-standing-authority.mjs",
    "mutate:standing-authority": "node scripts/check-standing-authority.mjs --mutation",
    "test:authority-trajectory-admission": "node --test apps/hypervisor/scripts/lib/authority-trajectory-admission.test.mjs",
    "check:authority-trajectory-admission": "node scripts/check-authority-trajectory-admission.mjs",
    "mutate:authority-trajectory-admission": "node scripts/check-authority-trajectory-admission.mjs --mutation",
    "check:approval-habituation": "node scripts/check-approval-habituation.mjs",
    "mutate:approval-habituation": "node scripts/check-approval-habituation.mjs --mutation",
    "check:secret-free-unattended-authority": "node scripts/check-secret-free-unattended-authority.mjs",
    "check:passkey-only-authority": "node scripts/check-passkey-only-authority.mjs --mutation",
    "check:router-path-params": "node scripts/check-router-path-params.mjs",
    "mutate:router-path-params": "node scripts/check-router-path-params.mjs --mutation",
    "check:ioi-ai-vendor": "node scripts/generate-ioi-ai-vendor-manifest.mjs --check",
    "smoke:implementation-daemon": "node scripts/smoke-implementation-daemon.mjs",
    "smoke:package-registry": "node scripts/smoke-package-registry.mjs",
    "smoke:product-surfaces": "node scripts/smoke-product-surfaces.mjs",
    "test:smoke-fence": "node --test scripts/lib/watchevents-fence.test.mjs",
    "test:system-genesis-compiler": "cargo test --locked -p ioi-types system_genesis",
    "dev:web": "npm run dev --workspace=@ioi/hypervisor-app",
    "build:workbench": "npm run build --workspace=@ioi/hypervisor-workbench",
    "build:workspace-substrate": "npm run build --workspace=@ioi/workspace-substrate",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check:architecture-docs": "node scripts/check-architecture-docs.mjs",
    "check:work-items": "node scripts/check-architecture-docs.mjs --work-items"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mdast-util-from-markdown": "^2.0.2",
    "playwright": "^1.60.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1"
  }
}
